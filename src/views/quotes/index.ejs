<%- include('../partials/header', { title, user }) %>
<section class="card">
  <h1>Devis</h1>
  <a class="button" href="/quotes/new">Nouveau devis</a>
  <table>
    <thead>
      <tr>
        <th>Numéro</th>
        <th>Client</th>
        <th>Statut</th>
        <th>Créé le</th>
        <th>Auteur</th>
      </tr>
    </thead>
    <tbody>
      <% quotes.forEach((quote) => { %>
      <tr>
        <td><a href="/quotes/<%= quote.id %>"><%= quote.quote_number %></a></td>
        <td><%= quote.company_name %></td>
        <td><span class="badge <%= quote.status %>"><%= quote.status %></span></td>
        <td><%= quote.created_at %></td>
        <td><%= quote.created_by_name %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<%- include('../partials/footer') %>
