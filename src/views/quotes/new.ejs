<%- include('../partials/header', { title, user }) %>
<section class="card">
  <h1>Nouveau devis (<%= quoteNumber %>)</h1>
  <form method="post" action="/quotes" id="quote-form" class="form-grid">
    <label>
      Client *
      <select name="client_id" required>
        <option value="">Sélectionner</option>
        <% clients.forEach((client) => { %>
        <option value="<%= client.id %>"><%= client.company_name %></option>
        <% }) %>
      </select>
    </label>
    <label>Date d’émission <input type="date" name="issue_date" /></label>
    <label>Validité <input type="date" name="valid_until" /></label>
    <label>Remise (%) <input type="number" step="0.01" min="0" max="100" value="0" name="discount_rate" id="discount_rate" /></label>
    <label>Acompte (%) <input type="number" step="0.01" min="0" max="100" value="0" name="deposit_rate" id="deposit_rate" /></label>
    <label>Notes <textarea name="notes" rows="2"></textarea></label>

    <h2>Lignes</h2>
    <div id="lines">
      <div class="line-row">
        <input name="description" placeholder="Description" required />
        <input name="quantity" type="number" step="0.01" min="0" value="1" required />
        <input name="unit_price" type="number" step="0.01" min="0" value="100" required />
        <input name="vat_rate" type="number" step="0.01" min="0" value="20" required />
      </div>
    </div>

    <button type="button" id="add-line">+ Ajouter ligne</button>

    <section class="preview card">
      <h3>Aperçu des totaux</h3>
      <p>Total HT: <strong id="preview-ht">0.00</strong> €</p>
      <p>Total TVA: <strong id="preview-vat">0.00</strong> €</p>
      <p>Total TTC: <strong id="preview-ttc">0.00</strong> €</p>
      <p>Acompte: <strong id="preview-deposit">0.00</strong> €</p>
      <p>Reste: <strong id="preview-remaining">0.00</strong> €</p>
    </section>

    <button type="submit">Créer le devis</button>
  </form>
</section>
<script src="/quote-form.js"></script>
<%- include('../partials/footer') %>
